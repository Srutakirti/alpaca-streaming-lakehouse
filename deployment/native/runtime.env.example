# Copy to /etc/gce-hadoop-catalog/runtime.env on the VM and set the warehouse.
# All timestamps emitted by the pipeline remain UTC.
KAFKA_BROKER=127.0.0.1:19092
KAFKA_TOPIC=alpaca-bars
PIPELINE_RUNTIME_DIR=/var/lib/gce-hadoop-catalog/runtime

ICEBERG_CATALOG_TYPE=hadoop
ICEBERG_CATALOG_NAME=local
ICEBERG_WAREHOUSE=gs://REPLACE_WITH_WAREHOUSE_BUCKET/warehouse
ICEBERG_NAMESPACE=alpaca
ICEBERG_TABLE=bars_raw

# Required when ICEBERG_WAREHOUSE starts with gs://.
LOADER_JAR=/opt/gce-hadoop-catalog/current/lib/iceberg-loader.jar
GCS_CONNECTOR_JAR=/opt/gce-hadoop-catalog/current/lib/gcs-connector.jar

# Java heap and loader input/write bounds for an e2-micro.
# Quotes make this value safe for both systemd EnvironmentFile and interactive Bash source.
# The targeted logger override removes Kafka's five-second telemetry-registration noise.
LOADER_JAVA_OPTS="-Xms128m -Xmx384m -Dorg.slf4j.simpleLogger.log.org.apache.kafka.common.telemetry.internals.ClientTelemetryReporter=warn"
LOADER_MAX_POLL_RECORDS=1
# The loader flushes when either limit is reached. No committed batch exceeds
# LOADER_MAX_RECORDS even if a source WebSocket array is larger.
LOADER_MAX_RECORDS=1000
LOADER_MAX_SECONDS=300
