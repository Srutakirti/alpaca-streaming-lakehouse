# VM-only secret file: /etc/gce-hadoop-catalog/alpaca.env (mode 0640, root:gcehcatalog)
ALPACA_KEY=REPLACE_WITH_KEY
ALPACA_SECRET=REPLACE_WITH_SECRET
ALPACA_WS_URI=wss://stream.data.alpaca.markets/v2/iex
ALPACA_SYMBOLS=AAPL,MSFT
# Must match KAFKA_TOPIC in runtime.env for this candidate run.
KAFKA_TOPIC=alpaca-bars-direct-candidate
RUST_LOG=info
# Emit one operational metric snapshot per minute; final metrics always emit at shutdown.
METRICS_INTERVAL=60
